# Server Port (cPanel Node.js automatically assigns PORT in production)
PORT=3000

# Application Public URL
APP_URL="http://localhost:3000"

# MySQL Database Configuration (leave DB_HOST unset to run in-memory preview mode)
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Authentication & Session Security
JWT_SECRET=

# Initial Super Admin Account Seed (used only when users table is empty)
ADMIN_EMAIL=
ADMIN_PASSWORD=
